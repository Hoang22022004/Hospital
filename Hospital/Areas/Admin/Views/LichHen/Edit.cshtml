@model Hospital.Models.LichHen
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Chỉnh sửa Lịch hẹn";
    var bacSiList = ViewData["BacSiId"] as SelectList;

    // Dữ liệu hiện tại để JS sử dụng đồng bộ
    var currentLichHenId = Model.LichHenId.ToString();
    var currentBacSiId = Model.BacSiId.ToString();
    var currentLichLamViecId = Model.LichLamViecId.ToString();
    var currentKhungGioBatDau = Model.KhungGioBatDau.ToString(@"hh\:mm");
    var currentDichVuId = Model.DichVuId.ToString();
}

<form method="post" id="editBookingForm">
    <input type="hidden" asp-for="LichHenId" />
    <input type="hidden" asp-for="ThoiGianDat" />
    <input type="hidden" asp-for="TrangThai" />

    <div class="border p-4 mt-4 bg-white shadow-sm rounded">
        <div class="row pb-2">
            <h2 class="text-primary fw-bold">Chỉnh sửa Lịch hẹn</h2>
            <hr />
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            @* --- CỘT 1: THÔNG TIN KHÁCH HÀNG --- *@
            <div class="col-md-6">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold text-secondary">Thông tin Khách hàng</h4>
                    <div id="patientStatus"></div>
                </div>
                <hr class="mb-3 mt-0" />

                @* 1. SỐ ĐIỆN THOẠI (Đã đưa lên đầu) *@
                <div class="mb-3">
                    <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-primary text-white"><i class="bi bi-telephone"></i></span>
                        <input asp-for="SoDienThoai" id="phoneInput" class="form-control border-primary" placeholder="Nhập SĐT khách hàng..." />
                    </div>
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>

                @* 2. HỌ VÀ TÊN *@
                <div class="mb-3">
                    <label asp-for="TenKhachHang" class="form-label fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                    <input asp-for="TenKhachHang" id="nameInput" class="form-control" placeholder="Tên khách hàng" />
                    <span asp-validation-for="TenKhachHang" class="text-danger"></span>
                </div>

                @* 3. EMAIL *@
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Email" id="emailInput" class="form-control" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                @* 4. TRIỆU CHỨNG *@
                <div class="mb-3">
                    <label asp-for="TrieuChung" class="form-label fw-bold">Triệu chứng/Yêu cầu</label>
                    <textarea asp-for="TrieuChung" rows="3" class="form-control" placeholder="Mô tả tình trạng da hoặc yêu cầu riêng..."></textarea>
                </div>
            </div>

            @* --- CỘT 2: THÔNG TIN LỊCH HẸN --- *@
            <div class="col-md-6">
                <h4 class="fw-bold text-secondary">Thông tin Lịch hẹn</h4>
                <hr class="mb-3 mt-0" />

                @* BÁC SĨ PHỤ TRÁCH *@
                <div class="mb-3">
                    <label asp-for="BacSiId" class="form-label fw-bold">Bác sĩ phụ trách</label>
                    @if (User.IsInRole("Doctor"))
                    {
                        <input type="hidden" id="BacSiDropdown" asp-for="BacSiId" />
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-person-badge-fill text-primary"></i></span>
                            <input class="form-control bg-light fw-bold" value="@Model.BacSi?.HoTen" readonly />
                        </div>
                        <small class="text-muted fst-italic">Bác sĩ không thể tự thay đổi người phụ trách.</small>
                    }
                    else
                    {
                        <select id="BacSiDropdown" asp-for="BacSiId" asp-items="@bacSiList" class="form-select select2-dropdown-full shadow-sm">
                            <option value="">-- Chọn Bác sĩ điều phối --</option>
                        </select>
                    }
                    <span asp-validation-for="BacSiId" class="text-danger"></span>
                </div>

                @* CA LÀM VIỆC *@
                <div class="mb-3">
                    <label asp-for="LichLamViecId" class="form-label fw-bold">Ngày và Ca làm việc</label>
                    <select id="LichLamViecId" asp-for="LichLamViecId" class="form-select select2-dropdown-full shadow-sm" disabled>
                        <option value="">Đang tải dữ liệu...</option>
                    </select>
                    <span asp-validation-for="LichLamViecId" class="text-danger"></span>
                </div>

                @* KHUNG GIỜ *@
                <div class="mb-3">
                    <label asp-for="KhungGioBatDau" class="form-label fw-bold">Khung giờ cụ thể</label>
                    <select id="KhungGioBatDau" asp-for="KhungGioBatDau" class="form-select shadow-sm" disabled>
                        <option value="">Đang tải khung giờ...</option>
                    </select>
                    <span asp-validation-for="KhungGioBatDau" class="text-danger"></span>
                </div>

                @* DỊCH VỤ *@
                <div class="mb-3">
                    <label asp-for="DichVuId" class="form-label fw-bold">Dịch vụ điều trị</label>
                    <select id="DichVuId" asp-for="DichVuId" class="form-select select2-dropdown-full shadow-sm" disabled>
                        <option value="">Đang tải dịch vụ...</option>
                    </select>
                    <span asp-validation-for="DichVuId" class="text-danger"></span>
                </div>
            </div>
        </div>

        @* --- NÚT HÀNH ĐỘNG --- *@
        <div class="mt-4 pt-3 border-top text-end">
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 me-2">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-lg fw-bold">
                <i class="bi bi-check-circle-fill me-2"></i>CẬP NHẬT LỊCH HẸN
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // --- CÁC HÀM HELPER THỜI GIAN ---
        function timeToMinutes(timeStr) {
            if (!timeStr) return 0;
            var parts = timeStr.split(':');
            return parseInt(parts[0]) * 60 + parseInt(parts[1]);
        }

        function generateTimeSlots(gioBatDauStr, gioKetThucStr, thoiLuongPhut, bookedSlots, currentSlotTimeStr) {
            var slots = [];
            var startMinutes = timeToMinutes(gioBatDauStr);
            var endMinutes = timeToMinutes(gioKetThucStr);
            for (var currentMinutes = startMinutes; currentMinutes < endMinutes; currentMinutes += thoiLuongPhut) {
                var hour = Math.floor(currentMinutes / 60);
                var minute = currentMinutes % 60;
                if (currentMinutes + thoiLuongPhut > endMinutes) continue;
                var startTimeValue = ('0' + hour).slice(-2) + ':' + ('0' + minute).slice(-2);

                // Quan trọng: Cho phép chọn lại đúng cái khung giờ đang lưu của lịch này
                var isCurrentSlot = startTimeValue === currentSlotTimeStr;
                var isBooked = bookedSlots.includes(startTimeValue) && !isCurrentSlot;

                slots.push({
                    value: startTimeValue + ':00',
                    text: startTimeValue + ' - ' + ('0' + Math.floor((currentMinutes + thoiLuongPhut) / 60)).slice(-2) + ':' + ('0' + (currentMinutes + thoiLuongPhut) % 60).slice(-2),
                    disabled: isBooked,
                    selected: isCurrentSlot
                });
            }
            return slots;
        }

        $(document).ready(function () {
            var bacSiDropdown = $('#BacSiDropdown');
            var caDropdown = $('#LichLamViecId');
            var slotDropdown = $('#KhungGioBatDau');
            var dvDropdown = $('#DichVuId');

            // Đánh dấu lần load đầu tiên để giữ dữ liệu cũ
            bacSiDropdown.data('isInitialLoad', true);
            $('.select2-dropdown-full').select2({ theme: 'bootstrap-5', width: '100%' });

            // --- 1. LOGIC NHẬN DIỆN BỆNH NHÂN QUA SĐT ---
            $('#phoneInput').on('blur', function () {
                var phone = $(this).val();
                if (phone.length >= 10) {
                    $.get('@Url.Action("CheckPhoneNumber", "LichHen")', { phone: phone }, function (res) {
                        if (res.found) {
                            $('#nameInput').val(res.name);
                            $('#emailInput').val(res.email);
                            $('#patientStatus').html('<span class="badge bg-success-subtle text-success border border-success">Khách hàng cũ</span>');
                        } else {
                            $('#patientStatus').html('<span class="badge bg-primary-subtle text-primary border border-primary">SĐT mới</span>');
                        }
                    });
                }
            });

            // --- 2. LOGIC LOAD CA LÀM VIỆC & KHUNG GIỜ ---
            function loadLichLamViec(selectedBacSiId) {
                var isInitial = bacSiDropdown.data('isInitialLoad');
                $.ajax({
                    url: '@Url.Action("GetLichLamViecByBacSi", "LichHen")',
                    data: { bacSiId: selectedBacSiId },
                    success: function (data) {
                        window.caLamViecData = data; // Lưu biến global để dùng cho Khung giờ
                        caDropdown.empty().append('<option value="">-- Chọn Ca làm việc --</option>');
                        $.each(data, function (i, item) {
                            var option = $('<option>', { value: item.id, text: item.text });
                            if (isInitial && item.id.toString() === '@currentLichLamViecId') option.attr('selected', 'selected');
                            caDropdown.append(option);
                        });
                        caDropdown.attr('disabled', false).trigger('change.select2');

                        // Nếu load lần đầu, tự động kích hoạt load khung giờ cho ca hiện tại
                        if (isInitial && caDropdown.val()) {
                            caDropdown.trigger('change');
                        }
                    }
                });
            }

            caDropdown.on('change', function() {
                var caId = $(this).val();
                if(!caId || !window.caLamViecData) return;

                var ca = window.caLamViecData.find(x => x.id.toString() === caId);
                if(ca) {
                    var slots = generateTimeSlots(ca.gioBatDau, ca.gioKetThuc, ca.thoiLuongPhut, ca.bookedSlots, '@currentKhungGioBatDau');
                    slotDropdown.empty().append('<option value="">-- Chọn Khung giờ --</option>');
                    $.each(slots, function (i, s) {
                        var option = $('<option>', { value: s.value, text: s.text });
                        if (s.disabled) option.attr('disabled', 'disabled');
                        if (s.selected) option.attr('selected', 'selected');
                        slotDropdown.append(option);
                    });
                    slotDropdown.attr('disabled', false);
                }
            });

            // --- 3. LOGIC LOAD DỊCH VỤ ---
            function loadDichVuByBacSi(selectedBacSiId) {
                var isInitial = bacSiDropdown.data('isInitialLoad');
                $.ajax({
                    url: '@Url.Action("GetDichVuByBacSi", "LichHen")',
                    data: { bacSiId: selectedBacSiId },
                    success: function (data) {
                        dvDropdown.empty().append('<option value="">-- Chọn Dịch vụ --</option>');
                        $.each(data, function (i, item) {
                            var option = $('<option>', { value: item.value, text: item.text });
                            if (isInitial && item.value.toString() === '@currentDichVuId') option.attr('selected', 'selected');
                            dvDropdown.append(option);
                        });
                        dvDropdown.attr('disabled', false).trigger('change.select2');
                        // Kết thúc quá trình load lần đầu
                        if (isInitial) bacSiDropdown.data('isInitialLoad', false);
                    }
                });
            }

            bacSiDropdown.on('change', function () {
                var val = $(this).val();
                if(val) {
                    loadLichLamViec(val);
                    loadDichVuByBacSi(val);
                }
            });

            // Kích hoạt load dữ liệu ban đầu
            if (bacSiDropdown.val()) {
                bacSiDropdown.trigger('change');
            }

            // Check SĐT ngay nếu đã có sẵn dữ liệu
            if ($('#phoneInput').val()) {
                $('#phoneInput').trigger('blur');
            }
        });
    </script>
}