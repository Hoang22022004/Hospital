@model IEnumerable<Hospital.Models.LichHen>
@using Microsoft.AspNetCore.Mvc.Rendering
@using Hospital.Models
@{
    ViewData["Title"] = "Quản lý Lịch hẹn";
    var bacSiList = ViewData["BacSiId"] as SelectList;
    var trangThaiList = ViewData["TrangThaiList"] as List<SelectListItem>;
}

@* Thư viện bổ trợ *@
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* GIỮ NGUYÊN CSS TRẠNG THÁI CỦA BẠN */
    .badge-status {
        padding: 6px 12px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
    }

    .bg-cho-duyet {
        background-color: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .bg-da-xac-nhan {
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .bg-da-huy {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .bg-hoan-thanh {
        background-color: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    /* CSS ĐỂ TRẢI RỘNG VÀ XÓA NỀN PHẦN BẢNG */
    .table-container-flat {
        background: transparent !important; /* Xóa nền trắng của card */
        padding: 0 !important;
    }

    #tblData {
        background-color: transparent !important;
        border-collapse: separate;
        border-spacing: 0 8px; /* Tạo khoảng cách nhẹ giữa các hàng nếu muốn */
        width: 100% !important;
    }

        #tblData thead th {
            background-color: transparent !important; /* Xóa nền xám của header bảng */
            border-bottom: 2px solid #dee2e6;
            text-transform: uppercase;
            font-size: 0.75rem;
            color: #64748b;
            text-align: center;
        }

        #tblData tbody td {
            background-color: white; /* Giữ nền trắng cho từng ô để chữ rõ hơn */
            border-top: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
            padding: 15px;
            vertical-align: middle;
            text-align: center;
        }

        /* Bo góc cho hàng đầu và cuối của mỗi dòng (nếu thích kiểu thẻ phẳng) */
        #tblData tbody tr td:first-child {
            border-left: 1px solid #f1f5f9;
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
        }

        #tblData tbody tr td:last-child {
            border-right: 1px solid #f1f5f9;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }

    /* LÀM NỔI BẬT NÚT DUYỆT */
    .btn-duyet-highlight {
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.75rem;
        box-shadow: 0 4px 6px rgba(13, 110, 253, 0.2);
        transition: all 0.2s;
    }

        .btn-duyet-highlight:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 6px 12px rgba(13, 110, 253, 0.3);
        }

    .btn-action-sm {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        background: white;
        color: #64748b;
    }

        .btn-action-sm:hover {
            background: #f8fafc;
            color: #0d6efd;
        }

    .btn-delete-sm:hover {
        color: #dc3545;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        transition: 0.3s;
    }

    .hidden-column {
        display: none !important;
    }
</style>

<div class="container-fluid p-0">
    <div class="row pt-4 align-items-center px-3">
        <div class="col-6">
            <h2 class="text-primary mb-0 fw-bold"><i class="fas fa-calendar-check me-2"></i>Danh sách Lịch hẹn</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius:10px;">
                <i class="fas fa-plus-circle"></i> &nbsp; Đặt Lịch hẹn mới
            </a>
        </div>
    </div>
    <hr class="mt-2 mb-4" />

    @* GIỮ NGUYÊN THỐNG KÊ *@
    <div class="row g-3 mb-4 px-3">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-warning bg-opacity-10 text-warning me-3" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:12px;"><i class="fas fa-clock"></i></div>
                    <div>
                        <p class="text-muted mb-0 small fw-bold">CHỜ DUYỆT</p>
                        <h4 class="fw-bold mb-0">@Model.Count(x => x.TrangThai == TrangThaiLichHen.ChoDuyet)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="icon-box bg-success bg-opacity-10 text-success me-3" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:12px;"><i class="fas fa-user-check"></i></div>
                    <div>
                        <p class="text-muted mb-0 small fw-bold">ĐÃ XÁC NHẬN</p>
                        <h4 class="fw-bold mb-0">@Model.Count(x => x.TrangThai == TrangThaiLichHen.DaXacNhan)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* GIỮ NGUYÊN BỘ LỌC *@
    <div class="row mb-3 px-3">
        <div class="col-md-4">
            <div class="dropdown">
                <button class="btn btn-outline-info dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-filter"></i> Lọc dữ liệu theo...
                </button>
                <ul class="dropdown-menu w-100">
                    <li><a class="dropdown-item filter-option" data-filter="trangthai">Trạng thái</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="bacsi">Bác sĩ</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="ngayhen">Ngày hẹn</a></li>
                </ul>
            </div>
        </div>
        <div class="col-md-2">
            <button id="resetFilter" class="btn btn-outline-secondary w-100">Đặt lại</button>
        </div>
    </div>

    <div id="filterTrangThai" class="mb-3 px-3 d-none">
        <select id="trangThaiFilter" class="form-select"><option value="">-- Tất cả Trạng thái --</option><option value="Chờ Duyệt">Chờ Duyệt</option><option value="Đã Xác Nhận">Đã Xác Nhận</option><option value="Đã Hủy">Đã Hủy</option><option value="Hoàn Thành">Hoàn Thành</option></select>
    </div>

    <div id="filterBacSi" class="mb-3 px-3 d-none">
        <select id="bacSiFilter" class="form-select">
            <option value="">-- Tất cả Bác sĩ --</option>
            @foreach (var item in bacSiList)
            {
                <option value="@item.Text">@item.Text</option>
            }
        </select>
    </div>

    <div id="filterNgayHen" class="mb-3 px-3 d-none">
        <input type="date" id="ngayHenFilter" class="form-control" />
    </div>

    @* PHẦN NỘI DUNG THAY ĐỔI: TRẢI RỘNG VÀ XÓA NỀN *@
    <div class="table-container-flat px-3">
        <table id="tblData" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="text-align: left;">Khách hàng & SĐT</th>
                    <th>Thời gian hẹn</th>
                    <th>Bác sĩ & Dịch vụ</th>
                    <th>Ngày đặt</th>
                    <th class="hidden-column">StatusHidden</th>
                    <th>Trạng thái</th>
                    <th style="width: 200px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    TimeSpan endTimeSlot = obj.KhungGioBatDau.Add(TimeSpan.FromMinutes(obj.LichLamViec.ThoiLuongKhungGioPhut));
                    string statusText = obj.TrangThai switch
                    {
                        TrangThaiLichHen.ChoDuyet => "Chờ Duyệt",
                        TrangThaiLichHen.DaXacNhan => "Đã Xác Nhận",
                        TrangThaiLichHen.DaHuy => "Đã Hủy",
                        TrangThaiLichHen.HoanThanh => "Hoàn Thành",
                        _ => obj.TrangThai.ToString()
                    };
                    string statusClass = obj.TrangThai switch
                    {
                        TrangThaiLichHen.ChoDuyet => "bg-cho-duyet",
                        TrangThaiLichHen.DaXacNhan => "bg-da-xac-nhan",
                        TrangThaiLichHen.DaHuy => "bg-da-huy",
                        TrangThaiLichHen.HoanThanh => "bg-hoan-thanh",
                        _ => "bg-light"
                    };

                    <tr>
                        <td style="text-align: left;">
                            <div class="fw-bold text-dark">@obj.TenKhachHang</div>
                            <div class="text-muted small">@obj.SoDienThoai</div>
                        </td>
                        <td>
                            <div class="fw-bold">@obj.LichLamViec.NgayLamViec.ToString("dd/MM/yyyy")</div>
                            <div class="text-primary small fw-bold">@obj.KhungGioBatDau.ToString(@"hh\:mm") - @endTimeSlot.ToString(@"hh\:mm")</div>
                        </td>
                        <td>
                            <div class="small fw-bold text-dark"><i class="fas fa-user-md text-primary me-1"></i> @obj.BacSi.HoTen</div>
                            <div class="text-muted extra-small">@obj.DichVu.TenDichVu</div>
                        </td>
                        <td class="small text-muted">@obj.ThoiGianDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="hidden-column">@statusText</td>
                        <td>
                            <span class="badge-status @statusClass">@statusText</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                @if (obj.TrangThai == TrangThaiLichHen.ChoDuyet)
                                {
                                    <button class="btn-duyet-highlight" onclick="confirmDuyet('@obj.LichHenId', '@obj.TenKhachHang')">
                                        <i class="fas fa-check me-1"></i> DUYỆT
                                    </button>
                                    <form id="form-duyet-@obj.LichHenId" asp-action="DuyetLich" asp-route-id="@obj.LichHenId" method="post" class="d-none">@Html.AntiForgeryToken()</form>
                                }
                                <a asp-action="Edit" asp-route-id="@obj.LichHenId" class="btn-action-sm" title="Sửa"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@obj.LichHenId" class="btn-action-sm btn-delete-sm" title="Xóa"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        function confirmDuyet(id, name) {
            Swal.fire({
                title: 'Duyệt lịch hẹn?',
                text: "Xác nhận cho bệnh nhân " + name + " và tạo hồ sơ bệnh án?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                confirmButtonText: 'Đồng ý Duyệt'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', didOpen: () => { Swal.showLoading() } });
                    document.getElementById('form-duyet-' + id).submit();
                }
            })
        }

        $(document).ready(function () {
            var table = $('#tblData').DataTable({
                "language": { "url": "/js/i18n/vi.json" },
                "order": [[3, 'desc']],
                "columnDefs": [{ "targets": 4, "visible": false, "searchable": true }],
                "dom": '<"row mb-2"<"col-md-6"l><"col-md-6"f>>rt<"row mt-2"<"col-md-6"i><"col-md-6"p>>'
            });

            function applyFilters() {
                var bacSi = $('#filterBacSi').is(':visible') ? $('#bacSiFilter').val() : '';
                var trangThai = $('#filterTrangThai').is(':visible') ? $('#trangThaiFilter').val() : '';
                table.column(2).search(bacSi).column(4).search(trangThai).draw();
            }

            $('#bacSiFilter, #trangThaiFilter').on('change', applyFilters);
            $('.filter-option').on('click', function () {
                var filter = $(this).data('filter');
                $('#filterBacSi, #filterTrangThai, #filterNgayHen').addClass('d-none');
                if (filter === 'bacsi') $('#filterBacSi').removeClass('d-none');
                else if (filter === 'trangthai') $('#filterTrangThai').removeClass('d-none');
                else if (filter === 'ngayhen') $('#filterNgayHen').removeClass('d-none');
            });

            $('#resetFilter').on('click', function() {
                $('#bacSiFilter, #trangThaiFilter, #ngayHenFilter').val('');
                table.search('').columns().search('').draw();
                $('#filterBacSi, #filterTrangThai, #filterNgayHen').addClass('d-none');
            });
        });
    </script>
}