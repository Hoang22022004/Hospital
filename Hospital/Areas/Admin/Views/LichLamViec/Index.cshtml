@model IEnumerable<Hospital.Models.LichLamViec>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Quản lý Lịch làm việc";
    var bacSis = ViewBag.BacSis as SelectList;
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    .status-changer {
        background-color: #f8f9fa;
    }

    #tblData tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .hidden-column {
        display: none !important;
    }

    /* --- MOBILE OPTIMIZATION: Làm thẻ to bằng màn hình --- */
    @@media (max-width: 768px) {
        /* 1. Loại bỏ khoảng cách dư thừa của container */
        .container-fluid {
            padding-left: 8px !important;
            padding-right: 8px !important;
        }

        h2 {
            font-size: 1.25rem;
            padding-left: 5px;
        }
        /* 2. Ép bảng và tbody rộng hết cỡ */
        #tblData, #tblData tbody, #tblData tr {
            display: block !important;
            width: 100% !important;
        }

            #tblData thead {
                display: none;
            }

            #tblData tbody tr {
                border: 1px solid #e2e8f0;
                border-radius: 16px; /* Bo góc mượt hơn */
                margin-bottom: 16px;
                padding: 16px; /* Tăng khoảng cách bên trong thẻ */
                background: #fff;
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); /* Thêm đổ bóng nổi khối */
                margin-left: 0 !important;
                margin-right: 0 !important;
            }
            /* 3. Ép các ô td rộng 100% */
            #tblData tbody td {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                width: 100% !important;
                padding: 10px 0 !important; /* Tăng khoảng cách giữa các dòng nội dung */
                border: none !important;
                text-align: right !important;
                font-size: 0.95rem;
            }
                /* 4. Nhãn tiêu đề bên trái */
                #tblData tbody td::before {
                    content: attr(data-label);
                    font-weight: 700;
                    color: #64748b;
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    text-align: left;
                    flex: 1;
                }
                /* 5. Căn chỉnh lại hàng nút bấm thao tác */
                #tblData tbody td[data-label="Thao tác"] {
                    border-top: 1px solid #f1f5f9 !important;
                    margin-top: 8px;
                    padding-top: 15px !important;
                    justify-content: center !important;
                }

        .btn-group {
            width: 100%;
            display: flex;
            gap: 10px;
        }

            .btn-group a {
                flex: 1; /* Hai nút Sửa/Xóa chia đôi chiều rộng card */
                padding: 10px !important;
                display: flex;
                align-items: center;
                justify-content: center;
            }
    }
</style>

<div class="container-fluid p-0">
    <div class="row pt-4 px-3 align-items-center">
        <div class="col-8">
            <h2 class="text-primary fw-bold mb-0">Lịch làm việc Bác sĩ</h2>
        </div>
        <div class="col-4 text-end">
            <a asp-controller="LichLamViec" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-lg"></i> <span class="d-none d-md-inline">Thêm Ca</span>
            </a>
        </div>
    </div>

    <hr class="mt-2 mb-4 mx-3" />

    @* BỘ LỌC *@
    <div class="row mb-3 mx-2 filter-section">
        <div class="col-md-4 col-12 mb-2">
            <div class="dropdown">
                <button class="btn btn-outline-info dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-funnel"></i> Lọc dữ liệu
                </button>
                <ul class="dropdown-menu w-100 shadow">
                    <li><a class="dropdown-item filter-option" data-filter="bacsi"><i class="bi bi-person-badge"></i> Theo Bác sĩ</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="ngay"><i class="bi bi-calendar-event"></i> Theo Ngày làm việc</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="trangthai"><i class="bi bi-toggle2-on"></i> Theo Trạng thái</a></li>
                </ul>
            </div>
        </div>
        <div class="col-md-2 col-12">
            <button id="resetFilter" class="btn btn-outline-secondary w-100">
                <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
            </button>
        </div>
    </div>

    @* KHỐI NHẬP LIỆU LỌC *@
    <div class="px-3">
        <div id="filterBacSi" class="mb-3 d-none animate__animated animate__fadeIn">
            <label class="form-label small fw-bold">Chọn Bác sĩ:</label>
            <select id="bacSiFilter" class="form-select select2-dropdown">
                <option value="">-- Tất cả --</option>
                @if (bacSis != null)
                {
                    foreach (var item in bacSis)
                    {
                        <option value="@item.Text">@item.Text</option>
                    }
                }
            </select>
        </div>

        <div id="filterNgay" class="mb-3 d-none animate__animated animate__fadeIn">
            <label class="form-label small fw-bold">Chọn Ngày:</label>
            <input type="date" id="ngayFilter" class="form-control" />
        </div>

        <div id="filterTrangThai" class="mb-3 d-none animate__animated animate__fadeIn">
            <label class="form-label small fw-bold">Trạng thái:</label>
            <select id="trangThaiFilter" class="form-select">
                <option value="">-- Tất cả --</option>
                <option value="Hoạt động">Hoạt động</option>
                <option value="Tạm dừng">Tạm dừng</option>
            </select>
        </div>
    </div>

    <div class="px-2">
        <table id="tblData" class="table table-hover align-middle" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>Bác sĩ</th>
                    <th>Ngày làm việc</th>
                    <th>Giờ bắt đầu</th>
                    <th>Giờ kết thúc</th>
                    <th class="text-center">Thời lượng</th>
                    <th>Trạng thái</th>
                    <th class="hidden-column">Trạng thái (Text)</th>
                    <th class="text-end px-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td data-label="Bác sĩ" class="fw-bold text-dark">@obj.BacSi.HoTen</td>
                        <td data-label="Ngày">@obj.NgayLamViec.ToString("dd/MM/yyyy")</td>
                        <td data-label="Bắt đầu">@obj.GioBatDau.ToString(@"hh\:mm")</td>
                        <td data-label="Kết thúc">@obj.GioKetThuc.ToString(@"hh\:mm")</td>
                        <td data-label="Thời lượng">@obj.ThoiLuongKhungGioPhut phút</td>
                        <td data-label="Trạng thái">
                            @{
                                string statusText = obj.IsActive ? "Hoạt động" : "Tạm dừng";
                                string statusClass = obj.IsActive ? "bg-success" : "bg-secondary";
                            }
                            <span class="badge rounded-pill @statusClass">@statusText</span>
                        </td>
                        <td class="hidden-column">@statusText</td>
                        <td data-label="Thao tác" class="text-end">
                            <div class="btn-group">
                                <a asp-controller="LichLamViec" asp-action="Edit" asp-route-id="@obj.LichLamViecId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="LichLamViec" asp-action="Delete" asp-route-id="@obj.LichLamViecId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        function initializeDataTable(tableId, options) {
            return $(`#${tableId}`).DataTable($.extend(true, {
                "language": { "url": "/js/i18n/vi.json" },
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Tất cả"]],
                "pagingType": "simple_numbers",
                "responsive": true,
                "order": [[1, 'asc']],
            }, options));
        }

        $(document).ready(function () {
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                var filterVal = $('#ngayFilter').val();
                if (!filterVal || $('#filterNgay').hasClass('d-none')) return true;
                var rowDateStr = data[1];
                var parts = rowDateStr.split('/');
                var rowDateIso = parts[2] + '-' + parts[1] + '-' + parts[0];
                return rowDateIso === filterVal;
            });

            var table = initializeDataTable('tblData', {
                "columnDefs": [{ "targets": 6, "visible": false, "searchable": true }]
            });

            $('#bacSiFilter').select2({
                placeholder: "-- Tất cả --",
                allowClear: true,
                theme: 'bootstrap-5',
                width: '100%'
            });

            function applyFilters() {
                table.column(0).search('');
                table.column(6).search('');
                var bacSi = $('#bacSiFilter').val();
                if (bacSi && $('#filterBacSi').is(':visible')) {
                    table.column(0).search('^' + bacSi + '$', true, false);
                }
                var trangThai = $('#trangThaiFilter').val();
                if (trangThai && $('#filterTrangThai').is(':visible')) {
                    table.column(6).search('^' + trangThai + '$', true, false);
                }
                table.draw();
            }

            $('#bacSiFilter, #ngayFilter, #trangThaiFilter').on('change', applyFilters);

            $('.filter-option').on('click', function () {
                var filter = $(this).data('filter');
                $('#filterBacSi, #filterNgay, #filterTrangThai').addClass('d-none');
                if (filter === 'bacsi') $('#filterBacSi').removeClass('d-none');
                else if (filter === 'ngay') $('#filterNgay').removeClass('d-none');
                else if (filter === 'trangthai') $('#filterTrangThai').removeClass('d-none');
                $('#bacSiFilter').val('').trigger('change.select2');
                $('#ngayFilter').val('');
                $('#trangThaiFilter').val('');
                table.search('').columns().search('').draw();
            });

            $('#resetFilter').on('click', function () {
                $('#bacSiFilter').val('').trigger('change.select2');
                $('#ngayFilter').val('');
                $('#trangThaiFilter').val('');
                $('#filterBacSi, #filterNgay, #filterTrangThai').addClass('d-none');
                table.search('').columns().search('').draw();
            });
        });
    </script>
}