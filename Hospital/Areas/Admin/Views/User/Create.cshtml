@model Hospital.Areas.Admin.Models.CreateUserViewModel

@{
    ViewData["Title"] = "Tạo Tài khoản mới";
}

<style>
    .form-floating > label {
        color: #6c757d;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #0d6efd;
        font-weight: 600;
    }

    .role-guide-card {
        background-color: #f8f9fa;
        border-left: 4px solid #0d6efd;
    }
</style>

<div class="container-fluid p-0 animate__animated animate__fadeIn">
    @* HEADER *@
    <div class="d-flex justify-content-between align-items-center pt-4 pb-3">
        <div>
            <h2 class="text-navy fw-bold mb-0">Tạo Tài khoản Mới</h2>
            <p class="text-muted small mb-0">Cấp quyền truy cập cho nhân viên hoặc liên kết hồ sơ cho bệnh nhân.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <hr class="mt-0 mb-4" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="fw-bold text-secondary mb-4">
                            <i class="bi bi-person-badge me-2"></i>Thông tin tài khoản
                        </h5>

                        <div class="row g-3">
                            @* 1. Họ và Tên *@
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control border-0 bg-light rounded-3" placeholder="Họ tên" />
                                    <label asp-for="FullName">Họ và Tên <span class="text-danger">*</span></label>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>

                            @* 2. Số điện thoại (QUAN TRỌNG ĐỂ LIÊN KẾT) *@
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="PhoneNumber" class="form-control border-0 bg-light rounded-3" placeholder="0905xxxxxx" />
                                    <label asp-for="PhoneNumber">Số điện thoại liên kết <span class="text-danger">*</span></label>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            @* 3. Email *@
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control border-0 bg-light rounded-3" placeholder="name@example.com" />
                                    <label asp-for="Email">Địa chỉ Email đăng nhập <span class="text-danger">*</span></label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            @* 4. Mật khẩu *@
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control border-0 bg-light rounded-3" placeholder="Mật khẩu" />
                                    <label asp-for="Password">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>

                            @* 5. Vai trò *@
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Role" asp-items="@Model.RoleList" class="form-select border-0 bg-light rounded-3">
                                        <option disabled selected>-- Chọn Vai trò --</option>
                                    </select>
                                    <label asp-for="Role">Phân quyền hệ thống <span class="text-danger">*</span></label>
                                    <span asp-validation-for="Role" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold">
                                <i class="bi bi-person-plus-fill me-2"></i>HOÀN TẤT TẠO MỚI
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* HƯỚNG DẪN *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 role-guide-card mb-4">
                <div class="card-body">
                    <h6 class="fw-bold text-primary"><i class="bi bi-info-circle-fill me-2"></i>Quyền hạn vai trò</h6>
                    <ul class="list-unstyled small text-muted mt-3">
                        <li class="mb-3"><span class="badge bg-danger bg-opacity-10 text-danger me-2">Admin</span>Toàn quyền quản trị.</li>
                        <li class="mb-3"><span class="badge bg-primary bg-opacity-10 text-primary me-2">Doctor</span>Khám bệnh và kê đơn.</li>
                        <li class="mb-3"><span class="badge bg-info bg-opacity-10 text-info me-2">Receptionist</span>Đặt lịch và thanh toán.</li>
                        <li><span class="badge bg-success bg-opacity-10 text-success me-2">Patient</span>Tra cứu lịch sử sắc đẹp.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}