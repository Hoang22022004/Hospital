@using System.Linq
@{
    ViewData["Title"] = "Báo cáo Quản trị";
}

@* Thư viện xuất PDF *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    :root {
        --glass: rgba(255, 255, 255, 0.95);
        --shd: 0 10px 30px rgba(0,0,0,0.05);
        --hp-primary: #7367f0;
    }

    body {
        background: #f8f9fe;
    }

    /* --- STYLE STAT CARDS --- */
    .stat-card {
        border: none;
        border-radius: 20px;
        color: white;
        padding: 20px;
        transition: 0.3s;
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

        .stat-card i.bi {
            position: absolute;
            right: 10px;
            bottom: -10px;
            font-size: 3.5rem !important;
            opacity: 0.15 !important;
        }

    .card-modern {
        background: var(--glass);
        border-radius: 25px;
        border: none;
        box-shadow: var(--shd);
        backdrop-filter: blur(10px);
    }

    /* --- FILTER BUTTONS --- */
    .filter-btn {
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.1);
        color: white;
        border-radius: 10px;
        padding: 6px 16px;
        font-size: 0.8rem;
        transition: 0.3s;
        text-decoration: none;
    }

        .filter-btn.active {
            background: white;
            color: #1e3c72;
            font-weight: bold;
        }

    /* --- CUSTOM DATE RANGE BOX --- */
    #customDateBox {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px;
        border-radius: 12px;
        display: none;
        align-items: center;
        backdrop-filter: blur(5px);
    }

    /* --- PRINT STYLES: TỐI ƯU IN ĐẦY ĐỦ NỘI DUNG --- */
    @@media print {
        @@page {
            size: A4 landscape; /* Để nằm ngang cho đủ các biểu đồ */
            margin: 10mm;
        }
        /* Ẩn các thành phần điều hướng hệ thống */
        .no-print,
        nav,
        aside,
        header,
        .hp-topbar,
        .filter-btn,
        #customDateBox,
        .navbar-toggler,
        .btn-tra-cuu {
            display: none !important;
        }
        /* Đẩy nội dung báo cáo lên trên cùng */
        #reportContent {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            position: absolute;
            top: 0;
            left: 0;
        }
        /* ÉP TRÌNH DUYỆT IN MÀU NỀN */
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        body {
            background: white !important;
        }

        .stat-card {
            box-shadow: none !important;
            color: white !important;
            margin-bottom: 10px !important;
        }

        .card-modern {
            box-shadow: none !important;
            border: 1px solid #eee !important;
        }

        canvas {
            max-width: 100% !important;
            height: auto !important;
        }
    }

    @@media (max-width: 768px) {
        .stat-card {
            padding: 15px;
        }

            .stat-card h1, .stat-card h2 {
                font-size: 1.5rem !important;
            }

        .chart-container-main {
            height: 250px !important;
        }
    }
</style>

<div class="container-fluid py-3" id="reportContent">
    @* THANH THAO TÁC SÁNG TẠO *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 no-print">
        <div>
            <h4 class="fw-bold text-navy mb-0">Hệ thống Báo cáo Chiến lược</h4>
            <p class="text-muted small mb-0">Dữ liệu cập nhật thời gian thực</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="exportToPDF()" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Xuất PDF
            </button>
            <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> In báo cáo
            </button>
        </div>
    </div>

    @* DASHBOARD STATS *@
    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #7367f0 0%, #9e95f5 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Bệnh nhân</h6>
                <h1 class="fw-bold my-1 count-up" data-value="@ViewBag.TotalPatients">0</h1>
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #ff9f43 0%, #ffc085 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Lịch hẹn</h6>
                <h1 class="fw-bold my-1 count-up" data-value="@ViewBag.AppointmentsToday">0</h1>
                <i class="bi bi-calendar-check"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #28c76f 0%, #48da89 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Hoàn tất</h6>
                <h1 class="fw-bold my-1 count-up" data-value="@ViewBag.CompletedToday">0</h1>
                <i class="bi bi-check-circle"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Doanh thu</h6>
                <h2 class="fw-bold my-1"><span class="count-up" data-value="@ViewBag.RevDay">0</span>đ</h2>
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    @* MAIN CHART WITH DATE RANGE *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card p-3 p-md-4 shadow-lg" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 30px; border: none; color: white; -webkit-print-color-adjust: exact;">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4 gap-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-uppercase small"><i class="bi bi-graph-up-arrow me-2"></i>Biến động tài chính</h5>
                        <p class="small opacity-75 mb-0" id="revNote">Dữ liệu: Năm @DateTime.Now.Year</p>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center no-print">
                        <div id="customDateBox" class="gap-2 align-items-center">
                            <input type="date" id="startDate" class="form-control form-control-sm border-0" style="width:130px">
                            <span>đến</span>
                            <input type="date" id="endDate" class="form-control form-control-sm border-0" style="width:130px">
                            <button class="btn btn-sm btn-light rounded-circle" onclick="applyCustomRange()"><i class="bi bi-check-lg"></i></button>
                        </div>
                        <a href="javascript:void(0)" class="filter-btn" onclick="updateChart('week', this, @ViewBag.RevWeekTotal, 7)">Tuần</a>
                        <a href="javascript:void(0)" class="filter-btn" onclick="updateChart('month', this, @ViewBag.RevMonthTotal, @DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month))">Tháng</a>
                        <a href="javascript:void(0)" class="filter-btn active" onclick="updateChart('year', this, @ViewBag.RevYearTotal, 365)">Năm</a>
                        <button class="filter-btn" onclick="$('#customDateBox').css('display', 'flex')"><i class="bi bi-calendar-range"></i></button>
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-3 border-end border-white border-opacity-10 py-2 mb-3 mb-md-0">
                        <div class="row row-cols-2 row-cols-md-1">
                            <div class="mb-md-3">
                                <p class="opacity-75 small mb-0">Tổng doanh thu:</p>
                                <h4 class="fw-bold mb-0" id="dynTotal">@ViewBag.RevYearTotal.ToString("N0")đ</h4>
                            </div>
                            <div>
                                <p class="opacity-75 small mb-0">Trung bình/ngày:</p>
                                <h4 class="fw-bold mb-0" id="dynAvg">@((ViewBag.RevYearTotal / 365).ToString("N0"))đ</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9 chart-container-main" style="height: 320px; position: relative;">
                        <canvas id="revChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* SUB CHARTS - ĐÃ ĐƯỢC BAO LẠI ĐỂ IN ĐẦY ĐỦ *@
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-modern p-4">
                <h6 class="fw-bold mb-3 text-primary uppercase small"><i class="bi bi-award me-2"></i>Hiệu suất Bác sĩ</h6>
                <div class="chart-container-sub" style="height: 250px;"><canvas id="drChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-modern p-4">
                <h6 class="fw-bold mb-3 text-danger uppercase small"><i class="bi bi-shield-plus me-2"></i>Cơ cấu Bệnh lý</h6>
                <div class="chart-container-sub" style="height: 250px;"><canvas id="pathChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ds = {
            week: { l: @Html.Raw(ViewBag.WeekLabels), d: @Html.Raw(ViewBag.WeekData), n: "Tuần hiện tại" },
            month: { l: @Html.Raw(ViewBag.MonthLabels), d: @Html.Raw(ViewBag.MonthData), n: "Tháng @DateTime.Now.Month" },
            year: { l: @Html.Raw(ViewBag.YearLabels), d: @Html.Raw(ViewBag.YearData), n: "Năm @DateTime.Now.Year" }
        };

        let revChart;

        function init() {
            const isMobile = window.innerWidth < 768;
            const fontSize = isMobile ? 10 : 12;
            const ctx = document.getElementById('revChart').getContext('2d');

            revChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ds.year.l,
                    datasets: [{
                        data: ds.year.d,
                        borderColor: '#fff',
                        backgroundColor: 'rgba(255,255,255,0.1)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: isMobile ? 2 : 4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { color: 'rgba(255,255,255,0.6)', font: { size: fontSize } }, grid: { display: false } },
                        x: { ticks: { color: '#fff', font: { size: fontSize } } }
                    }
                }
            });

            new Chart(document.getElementById('drChart'), {
                type: 'bar',
                data: { labels: @Html.Raw(ViewBag.DrLabels), datasets: [{ data: @Html.Raw(ViewBag.DrCounts), backgroundColor: '#7367f0', borderRadius: 8 }] },
                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            new Chart(document.getElementById('pathChart'), {
                type: 'doughnut',
                data: { labels: @Html.Raw(ViewBag.PathLabels), datasets: [{ data: @Html.Raw(ViewBag.PathCounts), backgroundColor: ['#7367f0', '#ff9f43', '#28c76f', '#00cfe8', '#ea5455'] }] },
                options: { cutout: '70%', responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            $('.count-up').each(function() {
                var $t = $(this);
                $({ n: 0 }).animate({ n: $t.attr('data-value') }, { duration: 1500, step: function() { $t.text(Math.floor(this.n).toLocaleString()); } });
            });
        }

        function updateChart(type, btn, total, divisor) {
            $('.filter-btn').removeClass('active');
            if(btn) $(btn).addClass('active');
            $('#customDateBox').hide();

            revChart.data.labels = ds[type].l;
            revChart.data.datasets[0].data = ds[type].d;
            revChart.update();

            $('#revNote').text(ds[type].n);
            $('#dynTotal').text(total.toLocaleString() + "đ");
            $('#dynAvg').text(Math.floor(total/divisor).toLocaleString() + "đ");

            Swal.fire({
                title: 'Đã cập nhật',
                text: 'Hiển thị dữ liệu ' + ds[type].n,
                icon: 'success',
                timer: 4000,
                timerProgressBar: true,
                showConfirmButton: false
            });
        }

        function applyCustomRange() {
            const startStr = $('#startDate').val();
            const endStr = $('#endDate').val();

            if(!startStr || !endStr) {
                Swal.fire({
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng chọn đầy đủ ngày bắt đầu và kết thúc',
                    icon: 'warning',
                    timer: 5000,
                    timerProgressBar: true
                });
                return;
            }

            // CHỨC NĂNG KIỂM TRA NGÀY: Ngày sau phải lớn hơn hoặc bằng ngày trước
            const startDate = new Date(startStr);
            const endDate = new Date(endStr);

            if (endDate < startDate) {
                Swal.fire({
                    title: 'Ngày không hợp lệ',
                    text: 'Ngày kết thúc không thể nhỏ hơn ngày bắt đầu. Vui lòng chọn lại!',
                    icon: 'error',
                    confirmButtonColor: '#7367f0',
                    timer: 5000,
                    timerProgressBar: true
                });
                return;
            }

            Swal.fire({ title: 'Đang trích xuất dữ liệu...', didOpen: () => Swal.showLoading() });

            $.get('/Admin/Dashboard/GetDataByRange', { start: startStr, end: endStr }, function(res) {
                Swal.close();
                if (res && res.labels) {
                    revChart.data.labels = res.labels;
                    revChart.data.datasets[0].data = res.values;
                    revChart.update();

                    $('#revNote').text("Dữ liệu từ " + startStr + " đến " + endStr);
                    $('#dynTotal').text(res.total.toLocaleString() + "đ");

                    let avg = res.count > 0 ? res.total / res.count : 0;
                    $('#dynAvg').text(Math.floor(avg).toLocaleString() + "đ");

                    $('#customDateBox').fadeOut();
                    $('.filter-btn').removeClass('active');

                    Swal.fire({
                        title: 'Thành công!',
                        text: 'Dữ liệu đã được cập nhật từ ' + startStr + ' đến ' + endStr,
                        icon: 'success',
                        timer: 5000,
                        timerProgressBar: true
                    });
                }
            }).fail(function() {
                Swal.fire('Lỗi', 'Không thể lấy dữ liệu từ máy chủ', 'error');
            });
        }

        function exportToPDF() {
            const element = document.getElementById('reportContent');
            Swal.fire({ title: 'Đang khởi tạo PDF...', didOpen: () => Swal.showLoading() });

            html2pdf().set({
                margin: 10,
                filename: 'Bao-cao-phong-kham-' + new Date().toLocaleDateString() + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            }).from(element).save().then(() => Swal.close());
        }

        $(document).ready(init);
    </script>
}