@using System.Linq
@{
    ViewData["Title"] = "Báo cáo Quản trị Chiến lược";
}

@* Thư viện hỗ trợ *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
@* SweetAlert2 để hiện thông báo khi lọc *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --glass: rgba(255, 255, 255, 0.95);
        --shd: 0 10px 30px rgba(0,0,0,0.05);
        --hp-primary: #7367f0;
    }

    body {
        background: #f8f9fe;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* --- STYLE STAT CARDS --- */
    .stat-card {
        border: none;
        border-radius: 20px;
        color: white;
        padding: 20px;
        transition: transform 0.3s;
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card i.bi {
            position: absolute;
            right: 10px;
            bottom: -10px;
            font-size: 3.5rem !important;
            opacity: 0.15 !important;
        }

    .card-modern {
        background: var(--glass);
        border-radius: 25px;
        border: none;
        box-shadow: var(--shd);
        backdrop-filter: blur(10px);
    }

    .filter-btn {
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.1);
        color: white;
        border-radius: 10px;
        padding: 6px 16px;
        font-size: 0.8rem;
        transition: 0.3s;
        text-decoration: none;
    }

        .filter-btn.active, .filter-btn:hover {
            background: white;
            color: #1e3c72;
            font-weight: bold;
        }

    #customDateBox {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px;
        border-radius: 12px;
        display: none;
        align-items: center;
        backdrop-filter: blur(5px);
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .stat-card {
            box-shadow: none !important;
            color: black !important;
            border: 1px solid #ddd !important;
        }
    }
</style>

<div class="container-fluid py-3" id="reportContent">
    @* THANH TIÊU ĐỀ *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 no-print">
        <div>
            <h4 class="fw-bold text-navy mb-0">Hệ thống Báo cáo Chiến lược</h4>
            <p class="text-muted small mb-0">Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="exportToPDF()" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Xuất PDF
            </button>
            <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> In báo cáo
            </button>
        </div>
    </div>

    @* 4 THẺ THỐNG KÊ *@
    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #7367f0 0%, #9e95f5 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Bệnh nhân</h6>
                <h1 class="fw-bold my-1">@ViewBag.TotalPatients</h1>
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #ff9f43 0%, #ffc085 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Lịch hẹn</h6>
                <h1 class="fw-bold my-1">@ViewBag.AppointmentsToday</h1>
                <i class="bi bi-calendar-check"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #28c76f 0%, #48da89 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Hoàn tất</h6>
                <h1 class="fw-bold my-1">@ViewBag.CompletedToday</h1>
                <i class="bi bi-check-circle"></i>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-lg h-100" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <h6 class="text-uppercase fw-bold opacity-75 small">Doanh thu hôm nay</h6>
                <h2 class="fw-bold my-1">@(((decimal)ViewBag.RevDay).ToString("N0"))đ</h2>
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    @* BIỂU ĐỒ DOANH THU CHÍNH *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card p-3 p-md-4 shadow-lg" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 30px; border: none; color: white;">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4 gap-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-uppercase small"><i class="bi bi-graph-up-arrow me-2"></i>Biến động tài chính</h5>
                        <p class="small opacity-75 mb-0" id="revNote">Dữ liệu: Năm @DateTime.Now.Year</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center no-print">
                        <div id="customDateBox" class="gap-2 align-items-center">
                            <input type="date" id="startDate" class="form-control form-control-sm border-0" style="width:130px">
                            <span>đến</span>
                            <input type="date" id="endDate" class="form-control form-control-sm border-0" style="width:130px">
                            <button class="btn btn-sm btn-light rounded-circle" onclick="applyCustomRange()"><i class="bi bi-check-lg"></i></button>
                        </div>
                        <a href="javascript:void(0)" class="filter-btn" onclick="updateChart('week', this, @ViewBag.RevWeekTotal, 7)">Tuần</a>
                        <a href="javascript:void(0)" class="filter-btn" onclick="updateChart('month', this, @ViewBag.RevMonthTotal, 30)">Tháng</a>
                        <a href="javascript:void(0)" class="filter-btn active" onclick="updateChart('year', this, @ViewBag.RevYearTotal, 365)">Năm</a>
                        <button class="filter-btn" onclick="$('#customDateBox').css('display', 'flex')"><i class="bi bi-calendar-range"></i></button>
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-3 border-end border-white border-opacity-10 py-2 mb-3 mb-md-0">
                        <div class="mb-3">
                            <p class="opacity-75 small mb-0">Tổng doanh thu:</p>
                            <h4 class="fw-bold mb-0" id="dynTotal">@(((decimal)ViewBag.RevYearTotal).ToString("N0"))đ</h4>
                        </div>
                        <div>
                            <p class="opacity-75 small mb-0">Trung bình/ngày:</p>
                            <h4 class="fw-bold mb-0" id="dynAvg">@(((decimal)ViewBag.RevYearTotal / 365).ToString("N0"))đ</h4>
                        </div>
                    </div>
                    <div class="col-md-9" style="height: 350px;">
                        <canvas id="revChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* CÁC BIỂU ĐỒ PHỤ *@
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-modern p-4">
                <h6 class="fw-bold mb-3 text-primary text-uppercase small"><i class="bi bi-award me-2"></i>Hiệu suất Bác sĩ</h6>
                <div style="height: 250px;"><canvas id="drChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-modern p-4">
                <h6 class="fw-bold mb-3 text-danger text-uppercase small"><i class="bi bi-shield-plus me-2"></i>Cơ cấu Bệnh lý</h6>
                <div style="height: 250px;"><canvas id="pathChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ds = {
            week: { l: @Html.Raw(ViewBag.WeekLabels), d: @Html.Raw(ViewBag.WeekData), n: "Tuần hiện tại" },
            month: { l: @Html.Raw(ViewBag.MonthLabels), d: @Html.Raw(ViewBag.MonthData), n: "Tháng @DateTime.Now.Month" },
            year: { l: @Html.Raw(ViewBag.YearLabels), d: @Html.Raw(ViewBag.YearData), n: "Năm @DateTime.Now.Year" }
        };

        let revChart;

        function init() {
            // Biểu đồ Doanh thu
            revChart = new Chart(document.getElementById('revChart'), {
                type: 'line',
                data: {
                    labels: ds.year.l,
                    datasets: [{
                        data: ds.year.d,
                        borderColor: '#fff',
                        backgroundColor: 'rgba(255,255,255,0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { color: 'rgba(255,255,255,0.6)' }, grid: { display: false } },
                        x: { ticks: { color: '#fff' } }
                    }
                }
            });

            // Biểu đồ Bác sĩ
            new Chart(document.getElementById('drChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(ViewBag.DrLabels),
                    datasets: [{ data: @Html.Raw(ViewBag.DrCounts), backgroundColor: '#7367f0', borderRadius: 8 }]
                },
                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });

            // Biểu đồ Bệnh lý
            new Chart(document.getElementById('pathChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(ViewBag.PathLabels),
                    datasets: [{ data: @Html.Raw(ViewBag.PathCounts), backgroundColor: ['#7367f0', '#ff9f43', '#28c76f', '#00cfe8', '#ea5455'] }]
                },
                options: { cutout: '70%', responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        }

        function updateChart(type, btn, total, divisor) {
            $('.filter-btn').removeClass('active');
            if(btn) $(btn).addClass('active');
            $('#customDateBox').hide();
            revChart.data.labels = ds[type].l;
            revChart.data.datasets[0].data = ds[type].d;
            revChart.update();
            $('#revNote').text(ds[type].n);
            $('#dynTotal').text(total.toLocaleString() + "đ");
            $('#dynAvg').text(Math.floor(total/divisor).toLocaleString() + "đ");
        }

        function applyCustomRange() {
            const start = $('#startDate').val();
            const end = $('#endDate').val();
            if (!start || !end) {
                Swal.fire('Thông báo', 'Vui lòng chọn đầy đủ ngày!', 'warning');
                return;
            }

            // Hiển thị thông báo đang tải
            Swal.fire({
                title: 'Đang xử lý...',
                text: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.get('/Admin/Dashboard/GetDataByRange', { start, end }, function (res) {
                Swal.close(); // Đóng thông báo
                if (res && res.labels) {
                    revChart.data.labels = res.labels;
                    revChart.data.datasets[0].data = res.values;
                    revChart.update();
                    $('#revNote').text("Từ " + start + " đến " + end);
                    $('#dynTotal').text(res.total.toLocaleString() + "đ");
                    $('#dynAvg').text(Math.floor(res.total / res.count).toLocaleString() + "đ");
                    $('#customDateBox').fadeOut();

                    // Thông báo thành công nhỏ (Toast)
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã cập nhật dữ liệu',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            });
        }

        function exportToPDF() {
            const element = document.getElementById('reportContent');
            html2pdf().from(element).save();
        }

        $(document).ready(init);
    </script>
}