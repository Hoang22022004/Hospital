@model IEnumerable<Hospital.Models.Thuoc>

@{
    ViewData["Title"] = "Kho Dược & Vật tư";
    var brandList = ViewBag.ThuongHieuList as List<string>;
}

@* --- CSS GIỮ NGUYÊN PHONG CÁCH --- *@
<style>
    .pharmacy-wrapper {
        padding: 20px;
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    .product-img {
        width: 48px !important;
        height: 48px !important;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .brand-tag {
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #495057;
        background-color: #e9ecef;
        padding: 5px 10px;
        border-radius: 4px;
        display: inline-block;
        white-space: nowrap;
    }

    .category-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        background: linear-gradient(45deg, #e7f5ff, #f3f0ff);
        color: #495057;
        border: 1px solid #dee2e6;
        white-space: nowrap;
    }

    .price-tag {
        font-family: 'Consolas', monospace;
        font-weight: 700;
        color: #2f9e44;
    }

    .stock-badge {
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .stock-ok {
        background-color: #ebfbee;
        color: #2b8a3e;
        border: 1px solid #d3f9d8;
    }

    .stock-out {
        background-color: #fff5f5;
        color: #fa5252;
        border: 1px solid #ffc9c9;
    }

    .filter-bar {
        background-color: #fff;
        border-radius: 15px;
        padding: 18px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        border: 1px solid #edf2f7;
    }

    .filter-item {
        min-width: 160px;
        flex: 1;
    }

    .filter-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: #adb5bd;
        text-transform: uppercase;
        margin-bottom: 5px;
        display: block;
        margin-left: 5px;
    }

    .form-select-custom {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        font-size: 0.85rem;
        height: 38px;
    }
</style>

<div class="pharmacy-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-1">Kho Dược phẩm</h3>
            <p class="text-muted small mb-0">Hệ thống quản lý thuốc và vật tư y tế.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 fw-bold">
            <i class="bi bi-plus-lg me-2"></i>Nhập Kho
        </a>
    </div>

    @* --- BỘ LỌC --- *@
    <div class="filter-bar">
        <div class="filter-item">
            <label class="filter-label">Thương hiệu</label>
            <select id="filterBrand" class="form-select form-select-custom">
                <option value="">Tất cả hãng</option>
                @if (brandList != null)
                {
                    foreach (var b in brandList)
                    {
                        <option value="@b">@b</option>
                    }
                }
            </select>
        </div>

        <div class="filter-item">
            <label class="filter-label">Danh mục</label>
            <select id="filterCategory" class="form-select form-select-custom" asp-items="Html.GetEnumSelectList<Hospital.Models.PhanLoaiThuoc>()">
                <option value="">Tất cả loại</option>
            </select>
        </div>

        <div class="filter-item">
            <label class="filter-label">Trạng thái kho</label>
            <select id="filterStock" class="form-select form-select-custom">
                <option value="">Tất cả trạng thái</option>
                <option value="Sẵn sàng">Còn hàng</option>
                <option value="Hết hàng">Hết hàng</option>
            </select>
        </div>

        <div class="filter-item">
            <label class="filter-label">Hạn dùng</label>
            <select id="filterExpiry" class="form-select form-select-custom">
                <option value="">Tất cả thời hạn</option>
                <option value="Còn hạn">Còn hạn</option>
                <option value="Đã hết hạn">Đã hết hạn</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button id="btnSearch" class="btn btn-primary rounded-pill px-4" style="height: 38px;">
                <i class="bi bi-search me-2"></i>Tìm kiếm
            </button>
            <button id="btnResetFilter" class="btn btn-light rounded-pill border" style="height: 38px;">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </div>

    @* --- BẢNG DỮ LIỆU --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0 table-responsive">
            <table id="tblThuoc" class="table align-middle mb-0 table-hover w-100">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Sản phẩm</th>
                        <th class="text-center">Thương hiệu</th>
                        <th class="text-center">Phân loại</th>
                        <th class="text-center">Đơn giá</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center">Hạn dùng</th>
                        <th class="text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.HinhAnhUrl) ? "/images/no-image.png" : item.HinhAnhUrl)" class="product-img me-3" />
                                    <div>
                                        <div class="fw-bold">@item.TenThuoc</div>
                                        <div class="text-muted small">@item.HoatChat</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center"><span class="brand-tag">@item.ThuongHieu</span></td>
                            <td class="text-center"><span class="category-badge">@Html.DisplayFor(m => item.PhanLoai)</span></td>
                            <td class="text-center"><span class="price-tag">@item.GiaBan.ToString("N0")</span></td>
                            <td class="text-center">
                                @if (item.SoLuongTon <= 0)
                                {
                                    <span class="stock-badge stock-out">Hết hàng</span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-ok">Sẵn sàng (@item.SoLuongTon)</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.HanSuDung.HasValue)
                                {
                                    <span>@item.HanSuDung.Value.ToString("dd/MM/yyyy")</span>
                                    if (item.HanSuDung >= DateTime.Now)
                                    {
                                        <span class="d-none">Còn hạn</span>
                                    }
                                    else
                                    {
                                        <span class="d-none">Đã hết hạn</span>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ThuocId" class="btn btn-sm text-primary"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.ThuocId" class="btn btn-sm text-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Khởi tạo DataTable
            var table = $('#tblThuoc').DataTable({
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": 'rt<"row p-3"<"col-md-6"i><"col-md-6"p>>',
                "pageLength": 10
            });

            // LOGIC TÌM KIẾM ĐÃ SỬA
            $('#btnSearch').on('click', function() {
                var brand = $('#filterBrand').val();

                // Lấy TEXT hiển thị của Category thay vì VALUE (số)
                var category = $('#filterCategory').val() ? $('#filterCategory option:selected').text().trim() : '';

                var stock = $('#filterStock').val();
                var expiry = $('#filterExpiry').val();

                // Lọc Thương hiệu (Cột 1) - Khớp chính xác
                table.column(1).search(brand ? '^' + brand + '$' : '', true, false);

                // Lọc Danh mục (Cột 2) - Khớp chính xác cụm từ hiển thị
                table.column(2).search(category ? '^' + category + '$' : '', true, false);

                // Lọc Tồn kho (Cột 4) - Lọc tương đối (Sẵn sàng/Hết hàng)
                table.column(4).search(stock);

                // Lọc Hạn dùng (Cột 5) - Lọc dựa trên văn bản ẩn "Còn hạn"/"Đã hết hạn"
                table.column(5).search(expiry);

                // Áp dụng tất cả bộ lọc
                table.draw();
            });

            // Nút Reset
            $('#btnResetFilter').on('click', function() {
                $('.form-select-custom').val('');
                table.columns().search('').draw();
            });
        });
    </script>
}